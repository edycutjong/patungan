# Patungan environment variables. Copy to .env (git-ignored) only for the scripts that need them.
# Nothing here is needed to run the tests or the web app: `forge test` and `npm test` work with no secrets.

# QIE mainnet RPC for the fork tests and scripts (chain 1990).
# Get from: public endpoints rpc1mainnet.qie.digital … rpc5mainnet.qie.digital (https://docs.qie.digital), no key needed.
QIE_RPC_URL=https://rpc1mainnet.qie.digital/

# Deployer key for script/deploy-mainnet.sh and script/seed-demo.py (spends real QIE; both refuse without CONFIRM=1).
# Get from: your own wallet (e.g. QIE Wallet → export private key). Keep it OUTSIDE the repo, e.g. ~/.config/patungan/,
# and load it with `set -a; . ~/.config/patungan/mainnet-deployer.env; set +a`. Never commit it.
DEPLOYER_PRIVATE_KEY=

# Explicit opt-in for anything that writes to QIE mainnet.
# Get from: you. Set to 1 only when you mean to spend real QIE.
CONFIRM=0

# Optional seed-demo.py inputs: pay a .qie name instead of an address.
# Get from: https://mainnet.qie.digital (the Zone name's current owner).
PAYEE_NAME=
PAYEE_ADDR=
